{
  "name": "dsh-relationship-notes",
  "version": "3.3.0",
  "type": "module",
  "description": "Relationship notebook for DeepSeek Harness: import chats, score every day from message-level evidence, and track how a relationship develops. All data stays on the local device.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "relationship",
    "memory",
    "chat-analytics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gao2612/relationship-notes.git"
  },
  "homepage": "https://github.com/Gao2612/relationship-notes#readme",
  "bugs": {
    "url": "https://github.com/Gao2612/relationship-notes/issues"
  },
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "reply-service.js",
    "import-service.js",
    "profile-service.js",
    "interpretation-service.js",
    "src/**/*.js",
    "client.js",
    "PDFJS-LICENSE.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node verify-v3.mjs",
    "prepublishOnly": "node verify-v3.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pdfjs-dist": "6.4.299"
  }
}
