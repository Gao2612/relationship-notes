{
  "name": "@local/relationship-notes",
  "version": "3.0.0",
  "private": false,
  "type": "module",
  "description": "A full-screen relationship workspace module inside DSH's 定制模块 container, with chat import, evidence-based analytics and editable replies.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "reply-service.js",
    "import-service.js",
    "build.mjs",
    "verify-v3.mjs",
    "src/*.js",
    "client.js",
    "PDFJS-LICENSE.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node verify-v3.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pdfjs-dist": "6.4.299"
  }
}
