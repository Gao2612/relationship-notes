}
export function formatChatTimestamp(value){
 const timezone='Asia/Shanghai';
 let date=null;
 if(typeof value==='number'||(typeof value==='string'&&/^\d{10,13}$/.test(value))){const n=Number(value);date=new Date(n<1e12?n*1000:n);}
 else if(typeof value==='string'&&value.trim()){
  const raw=value.trim(),local=/^(\d{4})[-/](\d{1,2})[-/](\d{1,2})(?:[ T](\d{1,2}):(\d{2})(?::\d{2})?)?$/.exec(raw);
  if(local)return `${Number(local[2])}/${Number(local[3])}${local[4]!==undefined?` ${local[4].padStart(2,'0')}:${local[5]}`:''}`;
  date=new Date(raw);
 }
 if(date&&Number.isFinite(date.getTime()))return new Intl.DateTimeFormat('zh-CN',{timeZone:timezone,month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit',hour12:false,hourCycle:'h23'}).format(date);
